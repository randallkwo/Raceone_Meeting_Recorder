# 複製為 /etc/meeting-recorder/meeting-recorder.env 並 chmod 600
# 切勿提交真實 token
#
# 這份檔案只放「設定」。機密一律留空，缺值時程式會停用對應功能，
# 不會偷偷用預設值或半殘的狀態跑。

# ---------- 服務 ----------
MEETING_PORT=8765
MEETING_TOKEN=CHANGE_ME_long_random_string

# Telegram 推播。留空 = 不推播（不會失敗，只是安靜地不通知）。
MEETING_CHAT_ID=

# ---------- 轉錄 ----------
# 模型大小與精度。small/int8 是 2 vCPU 機器上的甜蜜點。
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_BEAM=1
# 執行緒數（2 vCPU 建議 2；再高會因超額訂閱變慢）
WHISPER_THREADS=2
# 長檔切塊長度（秒）。faster-whisper 會把整段音訊載入記憶體，
# 不切塊的話記憶體會隨長度線性成長（3 小時約 713 MB）而撞破 worker 上限。
# 塊別切太小：實測 600s 塊與單次轉錄差 0.2%，300s 塊則差到 12.7%。
WHISPER_CHUNK_SEC=1800

# ---------- 會議紀要（LLM）----------
# 留空 = 只產逐字稿、不產紀要（會寫一則日誌說明，不會靜默消失）
OPENROUTER_API_KEY=

# ---------- GPU 加速（Runpod serverless）----------
# 沒有這兩個就一律走本機 CPU。
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# 長檔自動走 GPU。實測本機 RTF 0.144x vs GPU 0.0175x，
# 損益兩平（含冷啟）約 7 分鐘音訊；預設門檻取保守的 1200 秒。
GPU_AUTO=1
GPU_AUTO_MIN_SEC=1200
# 單塊長度與並行數（並行數請對齊 endpoint 的 workersMax）
GPU_CHUNK_SEC=600
GPU_PARALLEL=3

# ---------- Google Drive 歸檔 ----------
DRIVE_REMOTE=gdrive:RaceOne/Meetings
# 是否把原始音檔也歸檔（1=是）
DRIVE_AUDIO=1

# ---------- 音檔保留 ----------
# 歸檔成功後立刻刪除本機音檔（逐字稿／紀要／meta 永久保留）。
# 歸檔失敗時一律保留 —— 那時本機是唯一副本。
DELETE_AUDIO_AFTER_ARCHIVE=1
# 沒有歸檔成功、或關閉上面那項時的保險：幾天後清掉音檔。
RETENTION_DAYS=30
